#!/bin/sh
# BoBnox v5.0.0 GUI Launcher
# Starts FastAPI backend + Electron desktop app

BOBNOX_DIR="/usr/lib/bobnox"
PORT=8420

# Start backend server in background
cd "$BOBNOX_DIR"
python3 -m backend.server &
SERVER_PID=$!

# Wait for server to start
sleep 2

# Try Electron first, fall back to browser
if command -v electron >/dev/null 2>&1; then
    electron "$BOBNOX_DIR/electron/main.js" &
    APP_PID=$!
elif [ -f "/usr/lib/node_modules/electron/dist/electron" ]; then
    /usr/lib/node_modules/electron/dist/electron "$BOBNOX_DIR/electron/main.js" &
    APP_PID=$!
else
    # Fallback: open in browser
    URL="http://127.0.0.1:${PORT}"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$URL"
    elif command -v firefox >/dev/null 2>&1; then
        firefox "$URL" &
    fi
fi

# Keep running until app exits
wait ${APP_PID:-$SERVER_PID} 2>/dev/null
kill $SERVER_PID 2>/dev/null
